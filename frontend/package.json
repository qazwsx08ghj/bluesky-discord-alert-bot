{
  "name": "alertbot-control-panel",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "description": "Control panel for the Bluesky to Discord Alert Bot (built into the Docker image).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript ../docs/openapi.yaml --alphabetize -o src/api/schema.gen.ts",
    "api:check": "openapi-typescript ../docs/openapi.yaml --alphabetize -o src/api/schema.gen.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vite build && playwright test --project=panel",
    "screenshots": "vite build && playwright test --project=screenshots"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
