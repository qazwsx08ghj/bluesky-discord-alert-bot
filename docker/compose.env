# Settings for the Docker scripts (setup.bat, start.bat, update.bat). No secrets here:
# the Bluesky login and Discord channels are entered in the control panel.

# Empty: build the bot from this folder (development, or the source download).
# A release download sets the published image here, e.g. ghcr.io/OWNER/bluesky-discord-alert-bot:stable
ALERTBOT_IMAGE=

# The control panel opens at http://127.0.0.1:<port>. Change it only if 8000 is taken.
ALERTBOT_PORT=8000
