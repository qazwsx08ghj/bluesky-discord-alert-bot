# Nothing private or local goes into the image (the Dockerfile also checks this).
.env
.env.*
!.env.example
*.sqlite3
*.sqlite3-*
backups/
logs/

# Local tools and build leftovers
venv/
.venv/
.git/
.github/
.impeccable/
.vscode/
.idea/
**/__pycache__/
*.py[cod]
**/node_modules/
*.log

# The control panel is built inside the image (Dockerfile, stage "panel"), never copied in.
frontend/dist/
frontend/test-results/
frontend/playwright-report/

# Not needed to run the bot
docs/history/
dev/
*.bat
docker-compose*.yml
docker/compose.env
